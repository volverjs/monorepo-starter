# Public settings shared by every mode (committed): no secret here.

# app: the names shown in the UI, the page title and the PWA manifest
VITE_APP_NAME=Volver.js Startup Template
VITE_APP_SHORT_NAME=Volver.js
VITE_APP_TAGLINE=Startup Template
VITE_APP_DESCRIPTION=Modern web app template with monorepo structure.

# i18n
VITE_I18N_DEFAULT_LOCALE=en

# features
VITE_FEATURE_THEMES=true

# auth: comma separated, among microsoft, google, github, facebook (each one
# also needs its credentials in apps/backend/.env.local)
VITE_AUTH_SOCIAL_PROVIDERS=microsoft
