# Shared settings for local development. Secrets go in `.env.local` (git
# ignored), which Vite loads over this file: never write a real value here.

# better-auth (https://www.better-auth.com/docs/installation#set-environment-variables)
# Generate the secret with `openssl rand -base64 32` and put it in `.env.local`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://localhost:3000

# frontend
FRONTEND_URL=https://localhost:8080

# database (docker-compose.yml)
DATABASE_URL=postgres://postgres:Volverjs!@localhost:5432/monorepo_starter
# The integration tests drop, recreate and migrate `<database>_test` on the
# server of DATABASE_URL at every run. TEST_DATABASE_URL, when set, names
# another one (its name must end in _test).

# microsoft auth
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# google auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# github auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# facebook auth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# email
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=
