{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "targetDefaults": {
        "dev": {
            "dependsOn": [
                "^build"
            ]
        },
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "{projectRoot}/dist"
            ],
            "cache": true
        },
        "build-staging": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "{projectRoot}/dist"
            ],
            "cache": true
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "cache": true
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "cache": true
        },
        "lint": {
            "cache": true
        }
    },
    "affected": {
        "defaultBase": "main"
    },
    "analytics": false
}
