{
    "name": "@volverjs/monorepo-starter",
    "description": "Modern web app template with monorepo structure.",
    "version": "0.0.0",
    "private": true,
    "packageManager": "pnpm@12.6.0",
    "type": "module",
    "scripts": {
        "dev": "nx run-many --targets=dev --parallel=10",
        "build": "nx run-many --targets=build --parallel=10",
        "build-staging": "nx run-many --targets=build-staging --parallel=10",
        "lint": "eslint . && stylelint \"{apps,packages}/**/*.{vue,scss}\"",
        "lint:fix": "eslint --fix . && stylelint --fix \"{apps,packages}/**/*.{vue,scss}\"",
        "typecheck": "nx run-many --targets=typecheck",
        "test": "nx run-many --targets=test",
        "verify": "pnpm deps:duplicates && node --test .claude/hooks/guard.test.mjs && pnpm lint && nx run-many --targets=typecheck,test,build && pnpm scaffold:check",
        "deps:duplicates": "node scripts/lockfile-duplicates.mjs",
        "scaffold:check": "node skills/volverjs-monorepo-starter/scripts/scaffold.mjs --check",
        "graph": "nx graph",
        "frontend:dev": "nx run frontend:dev",
        "frontend:build-staging": "nx run frontend:build-staging",
        "frontend:build-production": "nx run frontend:build",
        "frontend:typecheck": "nx run frontend:typecheck",
        "backend:dev": "nx run backend:dev",
        "backend:build": "nx run backend:build",
        "backend:test": "nx run backend:test",
        "backend:typecheck": "nx run backend:typecheck",
        "db:generate": "nx run database:generate",
        "db:migrate": "nx run database:migrate",
        "db:check": "nx run database:check",
        "db:studio": "nx run database:studio",
        "auth:generate-schema": "nx run auth:generate-schema"
    },
    "dependencies": {
        "@volverjs/data": "2.0.5",
        "@volverjs/form-vue": "1.1.7",
        "@volverjs/query-vue": "2.1.1",
        "@volverjs/ui-vue": "0.0.24",
        "@volverjs/zod-vue-i18n": "0.0.10",
        "@vueuse/core": "^15.0.0",
        "@vueuse/router": "^15.0.0",
        "better-auth": "1.7.6",
        "drizzle-orm": "^0.45.3",
        "handlebars": "^4.7.10",
        "nodemailer": "^10.0.12",
        "pinia": "^4.0.3",
        "postgres": "^3.4.9",
        "type-fest": "^5.10.0",
        "vue": "^3.5.43",
        "vue-i18n": "^11.4.12",
        "vue-router": "^5.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@intlify/eslint-plugin-vue-i18n": "4.5.1",
        "@intlify/unplugin-vue-i18n": "^11.2.5",
        "@nabla/vite-plugin-eslint": "^3.0.1",
        "@nx/js": "23.2.1",
        "@nx/vite": "23.2.1",
        "@types/node": "^26.6.3",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@vue/eslint-config-typescript": "^14.9.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-vue": "^10.11.1",
        "nx": "23.2.1",
        "prettier": "^3.9.9",
        "sass": "^1.105.0",
        "stylelint": "^17.15.0",
        "stylelint-config-recommended-vue": "^2.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "6.0.3",
        "unplugin-auto-import": "^21.1.0",
        "vite": "^8.3.1",
        "vite-plugin-mkcert": "^2.1.0"
    },
    "license": "MIT",
    "engines": {
        "node": "^22.20.0 || >=24.12.0"
    }
}
